# Local template: copy to .env.eval and fill it in on your computer. Read only by `npm run eval`.
# Hosted providers may log requests and train on them: these keys serve synthetic stories only, never the bot.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# Daily caps per channel; see local/budget.ts. Defaults stay a tenth under the free allowance:
# OPENROUTER_FREE_DAILY_REQUESTS=900, OPENAI_SMALL_DAILY_TOKENS=2250000, OPENAI_LARGE_DAILY_TOKENS=225000.
# Billed channels are closed until you set a cap: OPENROUTER_PAID_DAILY_TOKENS, OPENAI_PAID_DAILY_TOKENS.
OPENROUTER_FREE_DAILY_REQUESTS=
OPENROUTER_PAID_DAILY_TOKENS=
OPENAI_SMALL_DAILY_TOKENS=
OPENAI_LARGE_DAILY_TOKENS=
# CEREBRAS_DAILY_TOKENS=900000, GROQ_DAILY_REQUESTS=900, GROQ_DAILY_TOKENS=180000.
# MISTRAL_DAILY_TOKENS=500000.
