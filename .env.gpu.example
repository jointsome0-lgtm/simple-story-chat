# Copy to .env.gpu. GPU commands overlay this onto the existing .env.
# No Telegram token or story database belongs on the rented GPU machine.
SIMPLE_CHAT_PROVIDER=llama-cpp
SIMPLE_CHAT_MODEL=gemma-4-31b-heretic-q6k
SIMPLE_CHAT_BASE_URL=http://127.0.0.1:8080
SIMPLE_CHAT_API_KEY=
SIMPLE_CHAT_MODEL_TIMEOUT_MS=600000
SIMPLE_CHAT_TEMPERATURE=0.8
SIMPLE_CHAT_CONTEXT_TOKENS=65536
SIMPLE_CHAT_MAX_OUTPUT_TOKENS=4096
SIMPLE_CHAT_COMPACT_AT_TOKENS=44000
SIMPLE_CHAT_KEEP_SCENES=4
# Experimental staged extraction: sgr. Background probes compare both modes.
SIMPLE_CHAT_MEMORY_MODE=plain
SIMPLE_CHAT_MEMORY_REPAIR_COVERAGE=false

# Optional Vast power controls. Key belongs in the bot host's private .env
# (SIMPLE_CHAT_VAST_API_KEY), or can be set privately in .env.gpu.
# Configure a verified SSH alias pointing to this exact instance.
SIMPLE_CHAT_VAST_INSTANCE_ID=
SIMPLE_CHAT_GPU_SSH_HOST=simple-chat-vast
SIMPLE_CHAT_GPU_IDLE_MINUTES=15
