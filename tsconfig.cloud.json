{
  "compilerOptions": {
    "strict": true,
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [],
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "newLine": "lf",
    "rootDir": "lib",
    "outDir": "lib"
  },
  "files": ["lib/library.ts"]
}
