{
  "name": "simple-story-chat",
  "private": true,
  "description": "Telegram bot for branching interactive stories: bring your own model (Claude Code, llama.cpp, Codex CLI or an OpenAI-compatible API); seeds, story tree, checkpoints, memory compaction and a world-consistency eval.",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.9.2",
    "tiktoken": "^1.0.22",
    "typescript": "7.0.2"
  },
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "test": "node --test local/*.test.ts",
    "test:serving": "node --test local/integration/serving.test.ts",
    "check": "tsc -p tsconfig.json",
    "start": "node local/start.ts",
    "start:gpu": "node --env-file=.env.gpu local/start.ts",
    "model:probe": "node --env-file=.env.gpu local/model-probe.ts",
    "story:probe": "node local/story-probe.ts",
    "memory:probe": "node --env-file=.env.gpu local/memory-probe.ts",
    "eval": "node local/eval.ts",
    "eval:stats": "node local/eval-stats.ts",
    "judge:extract": "node local/judge-extract-probe.ts",
    "illustrate:probe": "node local/illustrate-probe.ts",
    "image:batch": "node local/image-batch.ts",
    "image:portraits": "node local/image-portraits.ts",
    "image:blind": "node local/blind-review.ts",
    "agent": "node local/agent-cli.ts",
    "agent:gpu": "node --env-file=.env.gpu local/agent-cli.ts",
    "mcp": "node local/mcp.ts",
    "mcp:gpu": "node --env-file=.env.gpu local/mcp.ts",
    "gpu:diagnose": "node --env-file-if-exists=.env.gpu local/gpu-diagnose.ts",
    "gpu:measure": "node --env-file-if-exists=.env.gpu local/gpu-measure.ts",
    "gpu:fake": "node local/fake-llama.ts",
    "gpu:rent": "node --env-file-if-exists=.env.gpu gpu/rent.mjs",
    "tokenizers": "node local/tokenizer-extract.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
