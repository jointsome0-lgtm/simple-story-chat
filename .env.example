# Local template: copy to .env and fill it in on your computer.
# npm start reads .env; process environment overrides it. See docs/setup.md.
# Keep real keys, user IDs and private story text out of this example.

# Local bot: ordinary Bot API token from @BotFather, not a Serverless CLI token.
# Serverless is currently unavailable to our account (waitlist).
TELEGRAM_BOT_TOKEN=

# Local storage; data/ and SQLite files are ignored by Git.
SIMPLE_CHAT_DB_PATH=data/simple-chat.sqlite

# Owner's numeric ID: only this user's bot messages are approved for our debugging.
# Allowing someone to use the bot does not allow us to read their private stories.
SIMPLE_CHAT_OWNER_ID=

# Numeric Telegram user IDs, separated by commas. Start with your own ID.
# Add the tester only after our first run. Empty = startup refuses access.
SIMPLE_CHAT_ALLOWED_USER_IDS=

# Implemented: claude-code, llama-cpp, simple-serving (our gateway), codex-cli, openai-compatible.
# See .env.gpu.example, docs/gpu.md and docs/model-providers.md. codex-cli and openai-compatible send the story text
# to a hosted service that may keep it; the bot starts with them only after
# SIMPLE_CHAT_ALLOW_HOSTED=stories-leave-this-computer (your own stories only).
SIMPLE_CHAT_PROVIDER=claude-code
SIMPLE_CHAT_MODEL=claude-haiku-4-5-20251001

# llama-cpp: required for remote HTTPS; optional with a local SSH tunnel.
# simple-serving: always required, the bot's key in the gateway's configuration.
# claude-code: leave empty.
SIMPLE_CHAT_API_KEY=

# llama-cpp and simple-serving. Use HTTPS for a remote server; loopback HTTP is local-only.
# Use the server root, without /v1/chat/completions, query or embedded credentials.
SIMPLE_CHAT_BASE_URL=

# Model request timeout, including CLI or HTTP queue/prefill; no automatic retries.
SIMPLE_CHAT_MODEL_TIMEOUT_MS=600000
SIMPLE_CHAT_TEMPERATURE=0.8

# Total context budget, including the answer. Output is a maximum, not a target.
# Input is estimated from previous usage (UTF-8 bytes / 4 plus overhead otherwise)
# and checked against actual usage before the CLI emits narrative text.
SIMPLE_CHAT_CONTEXT_TOKENS=65536
SIMPLE_CHAT_MAX_OUTPUT_TOKENS=4096

# Compact before the next scene when its input reaches this threshold.
# Retain the newest scenes verbatim; all originals remain in checkpoints.
SIMPLE_CHAT_COMPACT_AT_TOKENS=54000
SIMPLE_CHAT_KEEP_SCENES=4
# Experimental staged extraction: sgr. Keep plain until your model passes probes.
SIMPLE_CHAT_MEMORY_MODE=plain
# Optional single supplement for uncited scenes, after comparing memory quality.
SIMPLE_CHAT_MEMORY_REPAIR_COVERAGE=false

# Optional key for Vast instance read/start/stop, never sent to the GPU/model.
SIMPLE_CHAT_VAST_API_KEY=
